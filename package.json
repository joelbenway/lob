{
  "name": "lob-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build:wasm": "cmake --preset=wasm && cmake --build --preset=wasm",
    "test": "node --test wasm/test/*.test.mjs example/loblab/test/*.test.mjs",
    "pretest:types": "npm --prefix wasm/test/types install --no-audit --no-fund",
    "test:types": "tsc --project wasm/test/types/tsconfig.json --noEmit",
    "test:browser": "node wasm/test/browser/run-browser-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write eslint.config.js package.json wasm/ example/loblab/",
    "format:check": "prettier --check eslint.config.js package.json wasm/ example/loblab/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
