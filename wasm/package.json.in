{
  "name": "@joelbenway/lob",
  "version": "@PROJECT_VERSION@",
  "description": "Exterior ballistics calculation library",
  "homepage": "https://github.com/joelbenway/lob",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelbenway/lob.git"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./raw": {
      "types": "./lob.d.ts",
      "import": "./lob.mjs",
      "default": "./lob.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "lob.mjs",
    "lob.d.ts",
    "lob.wasm",
    "README.md",
    "COPYING.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
