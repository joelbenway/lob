# Configuration for Doxygen for use with CMake
# Only options that deviate from the default are included
# To create a new Doxyfile containing all available options, call `doxygen -g`

# Get Project name and version from CMake
PROJECT_NAME = "@PROJECT_NAME@"
PROJECT_NUMBER = "@PROJECT_VERSION@"

# Add sources -- root docs (README, BUILDING, etc.) are intentionally excluded;
# they stand alone on GitHub. Only the technical pages are part of the site.
INPUT = "@PROJECT_SOURCE_DIR@/include" "@PROJECT_SOURCE_DIR@/docs/pages"
FILE_PATTERNS = *.h *.hpp *.c *.cpp *.md *.dox
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
RECURSIVE = YES
OUTPUT_DIRECTORY = "@DOXYGEN_OUTPUT_DIRECTORY@"
IMAGE_PATH = "@PROJECT_SOURCE_DIR@/docs/figures"
MARKDOWN_SUPPORT = YES
AUTOLINK_SUPPORT = YES
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = NO
PREDEFINED = LOB_EXPORT=

# Project brief for the landing page
PROJECT_BRIEF = "Exterior ballistics library — API + technical reference"

# set relative include paths
FULL_PATH_NAMES = YES
STRIP_FROM_PATH = "@PROJECT_SOURCE_DIR@/include" "@PROJECT_SOURCE_DIR@"
STRIP_FROM_INC_PATH =

# HTML presentation
LAYOUT_FILE = "@PROJECT_SOURCE_DIR@/docs/DoxygenLayout.xml"
GENERATE_HTML = YES
GENERATE_TREEVIEW = YES
HTML_DYNAMIC_MENUS = NO
DISABLE_INDEX = NO
GENERATE_LEGEND = YES
HTML_COLORSTYLE = LIGHT
HTML_EXTRA_STYLESHEET =
GENERATE_LATEX = NO
GENERATE_XML = NO
XML_PROGRAMLISTING = NO
CREATE_SUBDIRS = NO
QUIET = NO
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = NO
