[codespell]
builtin = clear,rare,en-GB_to_en-US,names,informal,code
check-filenames =
check-hidden =
skip = */.git,*/build,*/build-wasm,*/node_modules,*/prefix,*/.direnv,*/.opencode,*/.superpowers
quiet-level = 2
ignore-words-list = ws,cachegrind,valgrind,setarch,boatright,epicyclic,ir,cg,lets,iff,assertIn,trough,precesses,precession
